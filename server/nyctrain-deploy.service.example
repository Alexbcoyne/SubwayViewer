[Unit]
Description=Check for and deploy NYC Train Viewer updates
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=DEPLOY_REPO_ROOT=/home/pi/project-subwayviewer
Environment=DEPLOY_USER=pi
Environment=DEPLOY_BRANCH=main
WorkingDirectory=${DEPLOY_REPO_ROOT}
ExecStart=/bin/bash ${DEPLOY_REPO_ROOT}/scripts/deploy-on-pi.sh
